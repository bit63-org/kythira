+#if defined(CPPHTTPLIB_USE_NON_BLOCKING_GETADDRINFO) && !defined(_WIN32) &&   \
+    !(TARGET_OS_MAC && defined(__clang__))
+// An asynchronous getaddrinfo with a timeout and a cancel that work, used in
+// place of glibc's getaddrinfo_a(), gai_suspend() and gai_cancel(). Those
+// have two defects (glibc 2.39, still in 2.44.9000):
+//
+// 1. gai_suspend() links a waiter that lives on its own stack into the
+//    request. The resolver worker stores the result before it takes the
+//    request mutex and walks those waiters, and a gai_suspend() that wakes
+//    in between skips unlinking its waiter and returns; the worker then
+//    writes through the dead stack entry (glibc BZ #20874).
+// 2. gai_cancel() on a request still queued dequeues it and returns
+//    EAI_CANCELED but never sets its status, so gai_error() says
+//    EAI_INPROGRESS forever and waiting for it never ends.
+//
+// This is not glibc's code; it follows the same shape (a queue served by a
+// bounded set of worker threads, CPPHTTPLIB_ASYNC_RESOLVER_MAX_THREADS, that
+// exit after a second idle) with these rules:
+//
+// - A request lives on the heap and is shared by its caller and the queue,
+//   so a caller that gives up only drops its reference. No waiter ever puts
+//   memory of its own into shared state.
+// - A request's status changes only under the resolver mutex, together with
+//   the wake-up, so a waiter never sees "done" before the result is stored.
+// - Cancelling a queued request removes it and marks it cancelled at once.
+//   A running request cannot be stopped, but its caller need not wait for
+//   it: the worker frees it when getaddrinfo() returns.
+#ifndef CPPHTTPLIB_ASYNC_RESOLVER_MAX_THREADS
+#define CPPHTTPLIB_ASYNC_RESOLVER_MAX_THREADS 64
+#endif
+
+namespace async_resolver {
+
+struct request {
+  ~request() {
+    if (result) { freeaddrinfo(result); }
+  }
+
+  std::string node;
+  std::string service;
+  bool has_service = false;
+  bool has_hints = false;
+  struct addrinfo hints {};
+
+  // Guarded by resolver::mutex_. The condition variable is the request's
+  // own (on the heap, like the rest), so a completion wakes only the
+  // threads waiting for this request.
+  std::condition_variable done_cv;
+  int status = EAI_INPROGRESS;
+  bool running = false;
+  struct addrinfo *result = nullptr;
+};
+
+class resolver {
+public:
+  // Leaked on purpose: detached workers may still use it during exit.
+  static resolver &instance() {
+    static resolver *r = new resolver;
+    return *r;
+  }
+
+  // Queues `req`. Returns 0, or EAI_AGAIN when no worker can be started.
+  int submit(const std::shared_ptr<request> &req) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    queue_.push_back(req);
+    if (idle_ < queue_.size() && threads_ < max_threads) {
+      try {
+        std::thread(&resolver::worker, this).detach();
+        ++threads_;
+      } catch (const std::system_error &) {
+        if (threads_ == 0) {
+          // Nobody would ever serve it.
+          queue_.pop_back();
+          return EAI_AGAIN;
+        }
+        // An existing worker will get to it.
+      }
+    }
+    lock.unlock();
+    work_cv_.notify_one();
+    return 0;
+  }
+
+  // Waits until `req` is no longer in progress or `deadline` passes, and
+  // returns its status.
+  int wait_until(const std::shared_ptr<request> &req,
+                 std::chrono::steady_clock::time_point deadline) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    req->done_cv.wait_until(lock, deadline,
+                            [&] { return req->status != EAI_INPROGRESS; });
+    return req->status;
+  }
+
+  // EAI_CANCELED if `req` was still queued (it is removed and marked
+  // cancelled), EAI_NOTCANCELED if a worker is running it, EAI_ALLDONE if
+  // it has finished.
+  int cancel(const std::shared_ptr<request> &req) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (req->status != EAI_INPROGRESS) { return EAI_ALLDONE; }
+    if (req->running) { return EAI_NOTCANCELED; }
+    for (auto it = queue_.begin(); it != queue_.end(); ++it) {
+      if (*it == req) {
+        queue_.erase(it);
+        break;
+      }
+    }
+    req->status = EAI_CANCELED;
+    req->done_cv.notify_all();
+    return EAI_CANCELED;
+  }
+
+  // Takes the finished result out of `req`, under the lock.
+  struct addrinfo *take_result(const std::shared_ptr<request> &req) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto res = req->result;
+    req->result = nullptr;
+    return res;
+  }
+
+private:
+  // glibc's own pool stops at 20, which lets a burst of lookups of dead
+  // names (each holding a worker for resolv.conf's timeout times attempts)
+  // starve lookups of live ones. 64 workers keeps live names flowing in
+  // the overload tests while still bounding the threads a stalled DNS
+  // server can pin.
+  static constexpr size_t max_threads = CPPHTTPLIB_ASYNC_RESOLVER_MAX_THREADS;
+
+  void worker() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    for (;;) {
+      ++idle_;
+      auto got_work = work_cv_.wait_for(lock, std::chrono::seconds(1),
+                                        [&] { return !queue_.empty(); });
+      --idle_;
+      if (!got_work) {
+        --threads_;
+        return;
+      }
+      auto req = queue_.front();
+      queue_.pop_front();
+      req->running = true;
+      lock.unlock();
+
+      struct addrinfo *res = nullptr;
+      auto rc = getaddrinfo(req->node.c_str(),
+                            req->has_service ? req->service.c_str() : nullptr,
+                            req->has_hints ? &req->hints : nullptr, &res);
+
+      lock.lock();
+      req->result = res;
+      req->status = rc;
+      req->running = false;
+      lock.unlock();
+      // Wake the waiters and drop this worker's reference outside the
+      // lock. The reference keeps the request (and its condition variable)
+      // alive until then; if the caller has already given up, this frees
+      // the request and its result.
+      req->done_cv.notify_all();
+      req.reset();
+      lock.lock();
+    }
+  }
+
+  std::mutex mutex_;
+  std::condition_variable work_cv_;
+  std::list<std::shared_ptr<request>> queue_;
+  size_t threads_ = 0;
+  size_t idle_ = 0;
+};
+
+} // namespace async_resolver
+#endif
