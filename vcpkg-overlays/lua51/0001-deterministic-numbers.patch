+/* Kythira: a C cast of an out-of-range double, or of NaN, to an integer
+** is undefined. x86-64 answers the "integer indefinite" value (INT_MIN),
+** arm64 saturates and maps NaN to 0, so the same script would compute
+** different results on the two. These conversions saturate and map NaN to 0
+** on every architecture. */
+static inline int kythira_lua_num2int (double d) {
+  if (d != d) return 0;
+  if (d >= 2147483647.0) return INT_MAX;
+  if (d <= -2147483648.0) return INT_MIN;
+  return (int)d;
+}
+
+static inline long long kythira_lua_num2ll (double d) {
+  if (d != d) return 0;
+  if (d >= 9223372036854775808.0) return LLONG_MAX;
+  if (d < -9223372036854775808.0) return LLONG_MIN;
+  return (long long)d;
+}
+
+/* Kythira: one NaN bit pattern (positive, quiet) for every NaN that leaves
+** the interpreter as bytes (string.format, struct.pack, cmsgpack.pack). */
+static inline double kythira_lua_canonical_nan (double d) {
+  return (d != d) ? __builtin_nan("") : d;
+}
+
+#define lua_number2int(i,d)	((i)=kythira_lua_num2int(d))
+#define lua_number2integer(i,d)	((i)=(lua_Integer)kythira_lua_num2ll(d))
 
