# Settings every Kythira gateway in a differential layout shares
# (compose.yml here, and any later layout such as a front-end/data split).
# Per-node settings (KYTHIRA_NODE_ID, KYTHIRA_PEERS,
# KYTHIRA_REDIS_PEER_GATEWAYS, roles) stay in the compose file, because
# they name that layout's services.

KYTHIRA_RAFT_PORT=7000
# Raft and forwarding cross a private compose network in plaintext.
KYTHIRA_ALLOW_PLAINTEXT_RAFT=true
KYTHIRA_REDIS_ALLOW_PLAINTEXT_FORWARDING=true
KYTHIRA_REDIS_INTERNAL_SECRET=differential-internal
KYTHIRA_REDIS_LISTEN=0.0.0.0:6379
KYTHIRA_REDIS_ACL_FILE=/etc/kythira/acl.txt
# Two shards cut at "e": the generator's keys are a:<tag>..h:<tag>, so
# a..d and e..h live on different shards and MSET, MGET, multi-key DEL
# and MULTI blocks cross shards.
KYTHIRA_SHARD_CUTS=e
KYTHIRA_ELECTION_TIMEOUT_MIN_MS=300
KYTHIRA_ELECTION_TIMEOUT_MAX_MS=600
KYTHIRA_HEARTBEAT_INTERVAL_MS=75
KYTHIRA_CACHE_PERSISTENCE=memory
# A general-purpose store, not the compile cache: overwrites are legal (the
# immutable-value rule is design difference D11, opt-in per prefix later).
KYTHIRA_REDIS_IMMUTABLE_VALUES=false
KYTHIRA_REDIS_TRANSACTIONS=on
KYTHIRA_REDIS_TXN_ISOLATION=snapshot
KYTHIRA_REDIS_COMMAND_TIMEOUT_MS=5000
