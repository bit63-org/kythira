{
  "source": "https://docs.aws.amazon.com/kms/latest/developerguide/key-policies.html",
  "description": "KMS key policies through IAM's evaluator (.kiro/specs/kms-compatible-api/ Requirement 7.3, 7.6): the default key policy's delegation to the account, key policies without it, cross-account use, kms:ViaService and kms:CallerAccount, and encryption context conditions. Grants are not here: the KMS evaluates them itself before IAM (design.md), so their cases are the KMS module's own (task 9). The KMS sets kms:CallerAccount, kms:ViaService and the encryption context keys; a case lists them in context as the KMS would.",
  "cases": [
    {
      "name": "default key policy delegates: identity allow is enough",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "kms:Encrypt",
      "resource": "arn:aws:kms:us-east-1:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab",
      "source": "https://docs.aws.amazon.com/kms/latest/developerguide/key-policy-default.html#key-policy-default-allow-root-enable-iam",
      "resource_kind": "key",
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "Enable IAM User Permissions",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:root"
            },
            "Action": "kms:*",
            "Resource": "*"
          }
        ]
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "kms:Encrypt",
              "Resource": "arn:aws:kms:us-east-1:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
            }
          ]
        }
      ],
      "expect": "allow"
    },
    {
