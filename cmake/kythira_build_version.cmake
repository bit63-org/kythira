# Writes the definition of kythira::build_version() (include/raft/
# build_version.hpp). Invoked at configure time and before every build as
#   cmake -DSOURCE_DIR=<src> -DOUTPUT=<file.cpp> -DPROJECT_VERSION=<x.y.z>
#         [-DGIT_EXECUTABLE=<git>] -P cmake/kythira_build_version.cmake
# The file is rewritten only when its contents change, so an unchanged
# commit recompiles nothing and a new one recompiles one small file.
foreach(_var SOURCE_DIR OUTPUT PROJECT_VERSION)
    if(NOT DEFINED ${_var})
        message(FATAL_ERROR "kythira_build_version.cmake: pass -D${_var}=...")
    endif()
endforeach()

set(_version "${PROJECT_VERSION}")
if(GIT_EXECUTABLE AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --tags --always --dirty
        OUTPUT_VARIABLE _describe
        RESULT_VARIABLE _rc
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    # Only characters semver allows in build metadata, so the value can never
    # break the C++ string literal below or a parser downstream.
    if(_rc EQUAL 0 AND _describe MATCHES "^[0-9A-Za-z.-]+$")
        set(_version "${PROJECT_VERSION}+${_describe}")
    endif()
endif()

set(_contents "// Generated by cmake/kythira_build_version.cmake; do not edit.
#include <raft/build_version.hpp>

namespace kythira {

auto build_version() noexcept -> const char* {
    return \"${_version}\";
}

} // namespace kythira
")

set(_old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _old)
endif()
if(NOT _old STREQUAL _contents)
    file(WRITE "${OUTPUT}" "${_contents}")
endif()
