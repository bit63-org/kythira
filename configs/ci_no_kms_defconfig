# ci_no_kms_defconfig — ci_full_defconfig with the KMS module
# (services/kms/, .kiro/specs/kms-compatible-api/) switched off. kms-module.yml
# configures core with it to show that with CONFIG_KMS off nothing under
# services/kms/ is configured: no KMS target and no kms-module test.
# Written, like ci_full_defconfig, against `-DKYTHIRA_KCONFIG_STRICT=ON`; see
# that file's header for the reasoning behind every other line, which must
# stay verbatim from it.
#
#   KMS                     — the point of the file.
# CONFIG_KMS is not set
CONFIG_EDHOC=y
CONFIG_STDEXEC_BACKEND=y
CONFIG_BOOST_FUTURE_BACKEND=y
CONFIG_BOOST_BEAST_TRANSPORT=y
CONFIG_PROXYGEN_TRANSPORT=y
CONFIG_REDIS_GATEWAY=y
CONFIG_REDIS_GATEWAY_TRANSACTIONS=y
CONFIG_PROTOBUF_SERIALIZER=y
# CONFIG_GCP_SDK is not set
# CONFIG_GCP_PRIVATECA is not set
# CONFIG_GCP_STORAGE is not set
# CONFIG_GCP_STORAGE_PERSISTENCE is not set
# CONFIG_DNS_DISCOVERY is not set
# CONFIG_POCO_DISCOVERY is not set
CONFIG_IAM=y
CONFIG_KINESIS=y
CONFIG_DYNAMODB=y
CONFIG_HSM=y
CONFIG_SQS=y
CONFIG_SNS=y
CONFIG_S3=y
