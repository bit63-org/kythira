# ci_no_khold_defconfig — ci_full_defconfig with the khold module
# (services/khold/, .kiro/specs/khold-block-service/) switched off.
# khold-module.yml configures core with it to show that with CONFIG_KHOLD off
# nothing under services/khold/ is configured: no khold target and no
# khold-module test. Written, like ci_full_defconfig, against
# `-DKYTHIRA_KCONFIG_STRICT=ON`; see that file's header for the reasoning
# behind every other line, which must stay verbatim from it.
#
#   KHOLD                   — the point of the file.
# CONFIG_KHOLD is not set
CONFIG_EDHOC=y
CONFIG_STDEXEC_BACKEND=y
CONFIG_BOOST_FUTURE_BACKEND=y
CONFIG_BOOST_BEAST_TRANSPORT=y
CONFIG_PROXYGEN_TRANSPORT=y
CONFIG_REDIS_GATEWAY=y
CONFIG_REDIS_GATEWAY_TRANSACTIONS=y
CONFIG_PROTOBUF_SERIALIZER=y
# CONFIG_GCP_SDK is not set
# CONFIG_GCP_PRIVATECA is not set
# CONFIG_GCP_STORAGE is not set
# CONFIG_GCP_STORAGE_PERSISTENCE is not set
# CONFIG_DNS_DISCOVERY is not set
# CONFIG_POCO_DISCOVERY is not set
CONFIG_IAM=y
CONFIG_KINESIS=y
CONFIG_DYNAMODB=y
CONFIG_HSM=y
CONFIG_KMS=y
CONFIG_SQS=y
CONFIG_SNS=y
CONFIG_S3=y
